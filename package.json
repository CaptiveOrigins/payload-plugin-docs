{
  "name": "@extantape/payload-plugin-docs",
  "version": "0.1.0",
  "description": "Docs for Payload: a docs page for every feature your site lists, made and kept up to date by hook, with hand-written pages beside them, a publish-time lint for internals, and a check that nothing is missing.",
  "homepage": "https://github.com/ExtantApe/payload-plugin-docs#readme",
  "bugs": {
    "url": "https://github.com/ExtantApe/payload-plugin-docs/issues"
  },
  "keywords": [
    "payload",
    "payload-plugin",
    "payloadcms",
    "content",
    "documentation",
    "docs",
    "help-center",
    "knowledge-base",
    "feature-docs",
    "wiki"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExtantApe/payload-plugin-docs.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "leak-check": "bash scripts/leak-check.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "payload": "^3.80.0"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "3.92.1",
    "@types/node": "^24.0.0",
    "graphql": "^16.14.2",
    "mongodb-memory-server": "^11.3.0",
    "payload": "3.92.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
